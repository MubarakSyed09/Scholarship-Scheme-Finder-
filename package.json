{
  "name": "eligible-schemes-finder",
  "version": "1.0.0",
  "private": true,
  "description": "Full-stack Eligible Schemes Finder for Indian students",
  "scripts": {
    "dev:frontend": "cd frontend && npm run dev",
    "dev:backend": "cd backend && mvnw.cmd spring-boot:run",
    "build:frontend": "cd frontend && npm run build",
    "build:backend": "cd backend && mvnw.cmd clean package -DskipTests",
    "build": "npm run build:backend && npm run build:frontend",
    "test:backend": "cd backend && mvnw.cmd test"
  },
  "keywords": [
    "scholarships",
    "india",
    "spring-boot",
    "react",
    "vite",
    "tailwind"
  ]
}
